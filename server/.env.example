PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Remix VM Configuration (for MetaMask integration)
USE_REMIX_VM=true
REMIX_VM_URL=http://localhost:8545
CONTRACT_ADDRESS=

# Sepolia Testnet Configuration
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_MODE=simulated
# Set to 'sepolia' to use Sepolia testnet, 'remix-vm' for local, 'simulated' for default
